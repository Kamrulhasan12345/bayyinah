<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox alignment="TOP_CENTER" maxWidth="72.0" minWidth="72.0" prefWidth="72.0" spacing="14.0" styleClass="rail-root" xmlns="http://javafx.com/javafx/null" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ks.bayyinah.controller.RailNavigationController">
   <children>
      <StackPane fx:id="logoBtn" focusTraversable="true" styleClass="rail-button">
         <children>
            <FontIcon iconLiteral="mdi2b-book-open-variant" iconSize="21" styleClass="rail-logo-icon" />
         </children>
      </StackPane>
      <Region VBox.vgrow="ALWAYS" />

      <VBox alignment="TOP_CENTER" spacing="10.0" styleClass="rail-section">
         <children>
            <StackPane fx:id="readerBtn" focusTraversable="true" styleClass="rail-button">
               <children>
                  <FontIcon iconLiteral="mdi2b-book-open-page-variant-outline" iconSize="20" styleClass="rail-icon" />
               </children>
            </StackPane>
            <StackPane fx:id="bookmarksBtn" focusTraversable="true" styleClass="rail-button">
               <children>
                  <FontIcon iconLiteral="mdi2b-bookmark-outline" iconSize="20" styleClass="rail-icon" />
               </children>
            </StackPane>
            <StackPane fx:id="progressBtn" focusTraversable="true" styleClass="rail-button">
               <children>
                  <FontIcon iconLiteral="mdi2c-chart-line-variant" iconSize="20" styleClass="rail-icon" />
               </children>
            </StackPane>
            <StackPane fx:id="meetingBtn" focusTraversable="true" styleClass="rail-button">
               <children>
                  <FontIcon iconLiteral="mdi2a-account-group-outline" iconSize="20" styleClass="rail-icon" />
               </children>
            </StackPane>
         </children>
      </VBox>

      <Region VBox.vgrow="ALWAYS" />

      <VBox alignment="BOTTOM_CENTER" spacing="10.0" styleClass="rail-section rail-section-bottom">
         <children>
            <StackPane fx:id="peopleBtn" focusTraversable="true" styleClass="rail-button">
               <children>
                  <FontIcon iconLiteral="mdi2a-account-circle-outline" iconSize="20" styleClass="rail-icon" />
               </children>
            </StackPane>
            <StackPane fx:id="authBtn" focusTraversable="true" styleClass="rail-button">
               <children>
                  <FontIcon fx:id="authIcon" iconLiteral="mdi2l-login" iconSize="20" styleClass="rail-icon" />
               </children>
            </StackPane>
            <StackPane fx:id="settingsBtn" focusTraversable="true" styleClass="rail-button">
               <children>
                  <FontIcon iconLiteral="mdi2c-cog-outline" iconSize="20" styleClass="rail-icon" />
               </children>
            </StackPane>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="14.0" left="10.0" right="10.0" top="12.0" />
   </padding>
</VBox>
