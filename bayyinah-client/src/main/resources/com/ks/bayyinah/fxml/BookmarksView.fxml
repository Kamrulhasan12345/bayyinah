<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" styleClass="bookmarks-root" stylesheets="@../css/stylesheet.css"
   xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.ks.bayyinah.controller.BookmarksController">
   <children>
      <Label styleClass="bookmarks-title" text="Bookmarks" />
      <Label fx:id="summaryLabel" styleClass="bookmarks-summary" text="Loading bookmarks..."
         wrapText="true" />
      <ListView fx:id="bookmarksListView" styleClass="bookmarks-list" VBox.vgrow="ALWAYS" />
   </children>
   <padding>
      <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
   </padding>
</VBox>