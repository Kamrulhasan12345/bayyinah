<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" styleClass="meeting-root" stylesheets="@../css/stylesheet.css"
   xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.ks.bayyinah.controller.MeetingViewController">
   <children>
      <Label fx:id="statusLabel" styleClass="meeting-status-pill"
         text="Configure your room to start." />
      <StackPane VBox.vgrow="ALWAYS">
         <children>
            <VBox fx:id="entryPane" alignment="CENTER" spacing="18.0"
               styleClass="meeting-entry-root">
               <children>
                  <Label styleClass="meeting-title" text="Collaborative Halaqah" />
                  <Label styleClass="meeting-subtitle"
                     text="Create a room as leader or join with a room code." />
                  <HBox alignment="CENTER" spacing="18.0">
                     <children>
                        <VBox spacing="12.0" styleClass="meeting-card" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="meeting-card-title" text="Create Room" />
                              <Label styleClass="meeting-card-subtitle"
                                 text="You will connect automatically as leader." />
                              <TextField fx:id="createDisplayNameField" promptText="Display name" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label text="Max participants" />
                                    <Spinner fx:id="maxParticipantsSpinner" editable="true"
                                       prefWidth="120.0" />
                                 </children>
                              </HBox>
                              <Button fx:id="createRoomButton" onAction="#onCreateRoom"
                                 styleClass="meeting-primary-btn" text="Create Room" />
                           </children>
                        </VBox>
                        <VBox spacing="12.0" styleClass="meeting-card" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="meeting-card-title" text="Join Room" />
                              <Label styleClass="meeting-card-subtitle"
                                 text="Use a room code from the leader." />
                              <TextField fx:id="joinCodeField" promptText="Room code" />
                              <TextField fx:id="joinDisplayNameField" promptText="Display name" />
                              <Button fx:id="joinRoomButton" onAction="#onJoinRoom"
                                 styleClass="meeting-secondary-btn" text="Join Room" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <BorderPane fx:id="roomPane" managed="false" styleClass="meeting-room-root"
               visible="false">
               <top>
                  <fx:include fx:id="meetingHeader" source="Header.fxml" />
               </top>
               <center>
                  <SplitPane dividerPositions="0.62">
                     <items>
                        <VBox spacing="12.0" styleClass="meeting-reading-pane">
                           <children>
                              <Label styleClass="meeting-section-title" text="Chapter Focus" />
                              <Label fx:id="currentVerseLabel" styleClass="meeting-verse-focus"
                                 text="Current focus: Surah 1, Ayah 1" />
                              <ListView fx:id="chapterPreviewListView" prefHeight="220.0"
                                 VBox.vgrow="ALWAYS" />
                              <Separator />
                              <VBox fx:id="leaderControlsPane" spacing="8.0"
                                 styleClass="meeting-leader-panel">
                                 <children>
                                    <Label styleClass="meeting-section-title" text="Leader Controls" />
                                    <HBox spacing="8.0">
                                       <children>
                                          <TextField fx:id="surahField" promptText="Surah" />
                                          <TextField fx:id="ayahField" promptText="Ayah" />
                                          <Button fx:id="broadcastVerseButton"
                                             onAction="#onBroadcastVerse"
                                             styleClass="meeting-secondary-btn" text="Sync Verse" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                        <VBox spacing="12.0" styleClass="meeting-right-rail">
                           <children>
                              <Label styleClass="meeting-section-title" text="Participants" />
                              <ListView fx:id="participantsListView" prefHeight="180.0" />
                              <Label styleClass="meeting-section-title" text="Chat" />
                              <ListView fx:id="chatListView" VBox.vgrow="ALWAYS" />
                              <HBox spacing="8.0">
                                 <children>
                                    <TextField fx:id="chatInputField" onAction="#onSendChat"
                                       promptText="Send a message" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="sendChatButton" onAction="#onSendChat"
                                       styleClass="meeting-secondary-btn" text="Send" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </items>
                  </SplitPane>
               </center>
               <bottom>
                  <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="meeting-controls-bar">
                     <children>
                        <ToggleButton fx:id="muteToggleButton" onAction="#onToggleMute"
                           styleClass="meeting-secondary-btn" text="Mute" />
                        <Button fx:id="leaveRoomButton" onAction="#onLeaveRoom"
                           styleClass="meeting-danger-btn" text="Leave Room" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="connectionHintLabel" styleClass="meeting-subtle-text"
                           text="Disconnected" />
                     </children>
                  </HBox>
               </bottom>
            </BorderPane>
         </children>
      </StackPane>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>