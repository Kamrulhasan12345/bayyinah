<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="16.0"
   styleClass="reader-page" stylesheets="@../css/chapters-reader.css"
   xmlns="http://javafx.com/javafx/null" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.ks.bayyinah.controller.ChaptersController">
   <children>
      <HBox fx:id="header" disable="true" fillHeight="false" managed="false" visible="false" />
      <HBox alignment="CENTER" styleClass="reader-hero">
         <children>
            <VBox prefHeight="62.0" prefWidth="94.0">
               <children>
                  <Label fx:id="nameSimple" maxWidth="1.7976931348623157E308"
                     styleClass="chapter-name-simple" text="Al Fatihah">
                     <!-- <font>
                        <Font size="24.0" />
                     </font> -->
                  </Label>
                  <Label fx:id="translatedName" maxWidth="1.7976931348623157E308"
                     styleClass="chapter-name-translated" text="The Opener">
                     <!-- <font>
                        <Font size="24.0" />
                     </font> -->
                  </Label>
                  <Label fx:id="chapterMeta" maxWidth="1.7976931348623157E308"
                     styleClass="chapter-meta" text="7 ayah - makkah">
                     <!-- <font>
                        <Font size="24.0" />
                     </font> -->
                  </Label>
               </children>
            </VBox>
            <Region prefHeight="62.0" prefWidth="38.0" />
            <Label fx:id="nameArabic" maxWidth="1.7976931348623157E308"
               nodeOrientation="RIGHT_TO_LEFT" prefHeight="23.0" prefWidth="334.0"
               styleClass="chapter-name-arabic" text="الفاتحة" textAlignment="RIGHT">
               <font>
                  <Font name="Al Qalam Quran Majeed 2" size="29.0" />
               </font>
            </Label>
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="reader-toolbar">
         <children>
            <Label styleClass="toolbar-label" text="Translation" />
            <ComboBox fx:id="translationSelector" prefWidth="220.0" HBox.hgrow="ALWAYS" />
            <Separator orientation="VERTICAL" prefHeight="22.0" />
            <Button fx:id="tafsirToggleBtn" onAction="#onToggleTafsir"
               styleClass="reader-secondary-btn" text="Tafsir">
               <graphic>
                  <FontIcon iconLiteral="mdi2b-book-open-page-variant-outline" iconSize="16" />
               </graphic>
            </Button>
            <Button fx:id="audioToggleBtn" onAction="#onToggleAudio"
               styleClass="reader-secondary-btn" text="Audio">
               <graphic>
                  <FontIcon iconLiteral="mdi2v-volume-high" iconSize="16" />
               </graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <ListView fx:id="verseListView" styleClass="verse-list" VBox.vgrow="ALWAYS" />
   </children>
   <padding>
      <Insets left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>