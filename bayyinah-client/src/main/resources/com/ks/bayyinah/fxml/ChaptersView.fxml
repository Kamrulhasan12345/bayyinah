<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="16.0" styleClass="reader-page" stylesheets="@../css/chapters-reader.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ks.bayyinah.controller.ChaptersController">
   <children>
      <HBox fx:id="header" disable="true" fillHeight="false" managed="false" visible="false" />
      <VBox alignment="CENTER" spacing="6.0" styleClass="reader-hero">
         <children>
            <Label fx:id="nameSimple" alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="chapter-name-simple" text="Al-Fatihah" textAlignment="CENTER">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <Label fx:id="translatedName" alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="chapter-name-translated" text="The Beginning" textAlignment="CENTER">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <Label fx:id="nameArabic" alignment="CENTER" maxWidth="1.7976931348623157E308" nodeOrientation="RIGHT_TO_LEFT" styleClass="chapter-name-arabic" text="الفاتحة" textAlignment="CENTER">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <Label fx:id="chapterMeta" alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="chapter-meta" text="7 ayahs • Meccan" textAlignment="CENTER" />
         </children>
      </VBox>
      <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="reader-toolbar">
         <children>
            <Label styleClass="toolbar-label" text="Translation" />
            <ComboBox fx:id="translationSelector" prefWidth="220.0" HBox.hgrow="ALWAYS" />
            <Separator orientation="VERTICAL" prefHeight="22.0" />
            <Button fx:id="tafsirToggleBtn" onAction="#onToggleTafsir" styleClass="reader-secondary-btn" text="Tafsir">
               <graphic>
                  <FontIcon iconLiteral="mdi2b-book-open-page-variant-outline" iconSize="16" />
               </graphic>
            </Button>
            <Button fx:id="audioToggleBtn" onAction="#onToggleAudio" styleClass="reader-secondary-btn" text="Audio">
               <graphic>
                  <FontIcon iconLiteral="mdi2v-volume-high" iconSize="16" />
               </graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <ListView fx:id="verseListView" styleClass="verse-list" VBox.vgrow="ALWAYS" />
   </children>
   <padding>
      <Insets left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
